# Copy to .env on the machine that deploys. Never commit .env.
# The Fly app; deploy.ps1 tries this name first, then doorstep-flights-api and a suffixed fallback.
DOORSTEP_FLY_APP_NAME=doorstep-flights-api
FLY_API_TOKEN=
# Neon connection string; the API keeps its tables in the doorstep schema.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# The token that gates POST /v1/checks and POST /v1/score. Generated by deploy.ps1 when empty.
DOORSTEP_WRITE_TOKEN=
# Local test database for the persistence tests.
DOORSTEP_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/doorstep_test
