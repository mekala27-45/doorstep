    "population": "every metro and year in the window, through the metric layer",
    "seed": null,
    "seeds": null,
    "source": "mixed"
   },
   "rows": [
    [
     "households",
     "sum(estimate) filter (where variable = 'B11001_001')",
     "sum(households)"
    ],
    [
     "owner households",
     "sum(estimate) filter (where variable = 'B25003_002')",
     "sum(owner_households)"
    ],
    [
     "renter households",
     "sum(estimate) filter (where variable = 'B25003_003')",
     "sum(renter_households)"
    ],
    [
     "renters burdened",
     "sum(estimate) filter (where variable in ('B25070_007', 'B25070_008', 'B25070_009', 'B25070_010'))",
     "sum(renters_burdened)"
    ],
    [
     "renters severe",
     "sum(estimate) filter (where variable = 'B25070_010')",
     "sum(renters_severe)"
    ],
    [
     "renter burdened share",
     "sum(estimate) filter (where variable in ('B25070_007', 'B25070_008', 'B25070_009', 'B25070_010')) / (sum(estimate) filter (where variable = 'B25070_001') - coalesce(sum(estimate) filter (where variable = 'B25070_011'), 0))",
     "sum(renters_burdened) / sum(renters_with_share)"
    ],
    [
     "housing units",
     "sum(estimate) filter (where variable = 'B25001_001')",
     "sum(housing_units)"
    ],
    [
     "permits",
     "sum(permits)",
     "sum(permits)"
    ],
    [
     "population",
     "sum(population)",
     "sum(population)"
    ],
    [
     "domestic migration",
     "sum(domestic_migration)",
     "sum(domestic_migration)"
    ],
    [
     "purchase loans",
     "count(*) filter (where loan_purpose = 1)",
     "sum(purchase_loans)"
    ],
    [
     "refinance loans",
     "count(*) filter (where loan_purpose in (31, 32))",
     "sum(refinance_loans)"
    ],
    [
     "low rate originations",
     "count(*) filter (where interest_rate < 4.0 and not q_rate_missing and not q_term_not_30_years)",
     "sum(low_rate_originations)"
    ],
    [
     "turnover per 100 owners",
     "100.0 * sum(purchase_loans) / sum(owner_households)",
     "100.0 * sum(purchase_loans) / sum(owner_households)"
    ],
    [
     "lock in per 100 owners",
     "100.0 * sum(low_rate_originations) / sum(owner_households)",
     "100.0 * sum(low_rate_originations) / sum(owner_households)"
    ],
    [
     "permits per 100 households",
     "100.0 * sum(permits) / sum(households)",
     "100.0 * sum(permits) / sum(households)"
    ],
    [
     "domestic migration per 100",
     "100.0 * sum(domestic_migration) / sum(population)",
     "100.0 * sum(domestic_migration) / sum(population)"
    ],
    [
     "purchase under 35 share",
     "sum(purchase_under_35) / sum(purchase_with_age)",
     "sum(purchase_under_35) / sum(purchase_with_age)"
    ],
    [
     "owner mortgage burdened share",
     "sum(owners_mortgage_burdened) / sum(owners_mortgage_with_share)",
     "sum(owners_mortgage_burdened) / sum(owners_mortgage_with_share)"
    ],
    [
     "payment share ratio of sums",
     "12.0 * sum(payment) / sum(median_income)",
     "12.0 * sum(payment) / sum(median_income)"
    ],
    [
     "price to income ratio of sums",
     "sum(value_anchored) / sum(median_income)",
     "sum(value_anchored) / sum(median_income)"
    ]
   ]
  }
 },
